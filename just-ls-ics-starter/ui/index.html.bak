        <!-- Cal -->
        <section class="tab-panel" data-tab-panel="cal">
          <section class="panel">
            <div class="panel-header">
              <div>
                <div class="panel-title">定标 / Calibration</div>
                <div class="panel-kicker">本 Sprint：仅实现“主定标灯开关”真实控制；多光源选择先占位</div>
              </div>
              <div class="panel-actions">
                <span class="pill-soft" id="cal-cap-pill">cap: calib_lamps</span>
              </div>
            </div>

            <div class="control-group">
              <div class="control-card">
                <div class="control-title">主定标灯 <span class="control-sub">Master Lamp</span></div>
                <div class="hint">对应 v0.1 的 <code>lamp_on</code>；多灯种（Ne/HgAr/ThAr/FeAr/氘卤）在后续 API 扩展。</div>
                <form id="lamp-form-2">
                  <div class="form-row">
                    <label for="lamp2-on">状态</label>
                    <select id="lamp2-on">
                      <option value="true">ON</option>
                      <option value="false">OFF</option>
                    </select>
                  </div>
                  <div class="form-row" style="margin-top:8px; justify-content:flex-end;">
                    <button type="submit" class="btn btn-primary btn-sm" id="lamp2-submit-btn">应用</button>
                  </div>
                </form>
              </div>

              <div class="control-card">
                <div class="control-title">光源选择（占位） <span class="control-sub">Sources</span></div>
                <div class="form-row">
                  <label>光源</label>
                  <select disabled>
                    <option>Flat：氘卤光源（占位）</option>
                    <option>Arc：Ne（占位）</option>
                    <option>Arc：HgAr（占位）</option>
                    <option>Arc：ThAr（占位）</option>
                    <option>Arc：FeAr（占位）</option>
                  </select>
                </div>
                <div class="hint">说明：后续需要扩展 API（例如 <code>/api/v1/cal/source</code>）后才能接入。</div>
              </div>

