        <!-- Quicklook -->
        <section class="tab-panel" data-tab-panel="quicklook">
          <section class="panel">
            <div class="panel-header">
              <div>
                <div class="panel-title">数据快显 / Quicklook (占位)</div>
                <div class="panel-kicker">本 Sprint 不实现 FITS 写入/QC；仅占位</div>
              </div>
