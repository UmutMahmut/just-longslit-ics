        <!-- Logs -->
        <section class="tab-panel" data-tab-panel="logs">
          <section class="panel">
            <div class="panel-header">
              <div>
                <div class="panel-title">日志 / Logs</div>
                <div class="panel-kicker">前端内存日志（200条）+ 一键复制；后续可落盘或接数据库</div>
              </div>
              <div class="panel-actions">
                <button class="btn btn-sm" type="button" id="logs-copy-btn">复制日志</button>
                <button class="btn btn-sm" type="button" id="logs-clear-btn">清空</button>
              </div>
            </div>

            <section class="log-panel">
              <div class="log-header">
                <span>Event Log</span>
                <span id="log-count">0 / 200</span>
              </div>
              <ul class="log-list" id="log-list-full"></ul>
            </section>
          </section>
        </section>
      </main>
    </div>
  </div>

  <script>
    // ===== Constants =====
    const SLIT_SCALE_UM_PER_ARCSEC = 128.34;  // from P0: 128.34 um/arcsec

    // Observatory longitude (east positive), deg
    const OBS_LONGITUDE_DEG = 121.60424;

    // Polling
    const POLL_MIN_MS = 1000;
    const POLL_MAX_MS = 10000;
    const FETCH_TIMEOUT_MS = 5000;

    // Storage
    const LS_API_BASE = "justls_api_base_v1";

    // ===== DOM =====
    const apiBaseInput = document.getElementById("api-base-input");
    const apiBaseSaveBtn = document.getElementById("api-base-save");
    const apiBaseResetBtn = document.getElementById("api-base-reset");

    const connectionDot = document.getElementById("connection-dot");
    const connectionText = document.getElementById("connection-text");
    const connMetrics = document.getElementById("conn-metrics");

    const refreshStatusBtn = document.getElementById("refresh-status-btn");
    const quickRefreshBtn = document.getElementById("quick-refresh-btn");

    const pillRunmode = document.getElementById("pill-runmode");
    const pillHal = document.getElementById("pill-hal");

    const capTableBody = document.getElementById("cap-table-body");

    const statusFreshness = document.getElementById("status-freshness");

    const chipSlit = document.getElementById("chip-slit");
    const chipGrating = document.getElementById("chip-grating");
    const chipLamp = document.getElementById("chip-lamp");
    const chipTemp = document.getElementById("chip-temp");
    const chipSource = document.getElementById("chip-source");
    const chipServerUtc = document.getElementById("chip-server-utc");

    const kvSlitUm = document.getElementById("kv-slit-um");
    const kvSlitArcsec = document.getElementById("kv-slit-arcsec");
    const kvGrating = document.getElementById("kv-grating");
    const kvLamp = document.getElementById("kv-lamp");
    const kvTemp = document.getElementById("kv-temp");

    const statusRawPre = document.getElementById("status-raw-pre");

    const envTemp = document.getElementById("env-temp");
    const envPill = document.getElementById("env-pill");

    const slitReadback = document.getElementById("slit-readback");
    const slitReadbackHint = document.getElementById("slit-readback-hint");

    const slitCapPill = document.getElementById("slit-cap-pill");
    const calCapPill = document.getElementById("cal-cap-pill");
    const guidingCapPill = document.getElementById("guiding-cap-pill");
    const camerasCapPill = document.getElementById("cameras-cap-pill");

    const logList = document.getElementById("log-list");
    const logListFull = document.getElementById("log-list-full");
    const logCount = document.getElementById("log-count");

    const copyLogBtn = document.getElementById("copy-log-btn");
    const clearLogBtn = document.getElementById("clear-log-btn");
    const logsCopyBtn = document.getElementById("logs-copy-btn");
    const logsClearBtn = document.getElementById("logs-clear-btn");

    // Forms
    const slitForm = document.getElementById("slit-form");
    const slitUnit = document.getElementById("slit-unit");
    const slitSubmitBtn = document.getElementById("slit-submit-btn");

    const gratingForm = document.getElementById("grating-form");
    const gratingSubmitBtn = document.getElementById("grating-submit-btn");

    const lampForm = document.getElementById("lamp-form");
    const lampSubmitBtn = document.getElementById("lamp-submit-btn");

    const slitForm2 = document.getElementById("slit-form-2");
    const slit2SubmitBtn = document.getElementById("slit2-submit-btn");

    const lampForm2 = document.getElementById("lamp-form-2");
    const lamp2SubmitBtn = document.getElementById("lamp2-submit-btn");

    // Time
    const timeLocalSpan = document.getElementById("time-local");
    const timeUtcSpan = document.getElementById("time-utc");
    const timeLstSpan = document.getElementById("time-lst");

    // Tabs
    const tabs = document.querySelectorAll(".tab");
    const tabPanels = document.querySelectorAll(".tab-panel");

    // ===== State =====
    let apiBase = "";
    let pollTimer = null;
    let pollDelayMs = POLL_MIN_MS;

    let lastOkAt = null;
    let lastRttMs = null;
    let failCount = 0;

    let lastCapabilities = null;
    let lastState = null;
    let lastMeta = null;

    const LOG_MAX = 200;
    const logBuffer = [];

    // ===== Tabs behavior =====
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.getAttribute("data-tab");
        tabs.forEach((t) => t.classList.remove("tab-active"));
        tab.classList.add("tab-active");
        tabPanels.forEach((panel) => {
          const name = panel.getAttribute("data-tab-panel");
          panel.classList.toggle("tab-panel-active", name === target);
        });
      });
    });

    // ===== Logging =====
    function fmtTime(date) {
      const hh = String(date.getHours()).padStart(2, "0");
      const mm = String(date.getMinutes()).padStart(2, "0");
      const ss = String(date.getSeconds()).padStart(2, "0");
      const ms = String(date.getMilliseconds()).padStart(3, "0");
      return `${hh}:${mm}:${ss}.${ms}`;
    }

    function pushLog(level, message) {
      const ts = new Date();
      const line = `[${fmtTime(ts)}] ${level.toUpperCase()} ${message}`;
      logBuffer.push(line);
      while (logBuffer.length > LOG_MAX) logBuffer.shift();

      renderLogs();
    }

    function renderLogs() {
      if (logCount) logCount.textContent = `${logBuffer.length} / ${LOG_MAX}`;

      if (logList) {
        logList.innerHTML = "";
        const tail = logBuffer.slice(-12);
        for (const line of tail) {
          const li = document.createElement("li");
          li.className = "log-item";
          const t = document.createElement("span");
          t.className = "log-time";
          t.textContent = line.slice(1, 13);
          const msg = document.createElement("span");
          const isErr = line.includes(" ERROR ");
          const isOk = line.includes(" OK ");
          msg.className = "log-text" + (isErr ? " log-text--error" : isOk ? " log-text--success" : "");
          msg.textContent = line.slice(15);
          li.appendChild(t);
          li.appendChild(msg);
          logList.appendChild(li);
        }
      }

      if (logListFull) {
        logListFull.innerHTML = "";
        for (const line of logBuffer) {
          const li = document.createElement("li");
          li.className = "log-item";
          const t = document.createElement("span");
          t.className = "log-time";
          t.textContent = line.slice(1, 13);
          const msg = document.createElement("span");
          const isErr = line.includes(" ERROR ");
          const isOk = line.includes(" OK ");
          msg.className = "log-text" + (isErr ? " log-text--error" : isOk ? " log-text--success" : "");
          msg.textContent = line.slice(15);
          li.appendChild(t);
          li.appendChild(msg);
          logListFull.appendChild(li);
        }
      }
    }

    async function copyLogs() {
      const text = logBuffer.join("\n");
      try {
        await navigator.clipboard.writeText(text);
        pushLog("ok", "日志已复制到剪贴板。");
      } catch {
        pushLog("error", "复制失败（浏览器权限限制）。可手动选中文本复制。");
      }
    }

    function clearLogs() {
      logBuffer.length = 0;
      renderLogs();
      pushLog("info", "日志已清空。");
    }

    // ===== Time utils =====
    function pad2(n) { return String(n).padStart(2, "0"); }
    function fmtHMS(h, m, s) { return `${pad2(h)}:${pad2(m)}:${pad2(s)}`; }

    function dateToJulianDate(date) {
      const time = date.getTime();
      const JD_UNIX_EPOCH = 2440587.5;
      return time / 86400000 + JD_UNIX_EPOCH;
    }

    function gmstInHours(date) {
      const JD = dateToJulianDate(date);
      const D = JD - 2451545.0;
      let GMST = 18.697374558 + 24.06570982441908 * D;
      GMST = ((GMST % 24) + 24) % 24;
      return GMST;
    }

    function lstInHours(date, longitudeDeg) {
      let lst = gmstInHours(date) + longitudeDeg / 15.0;
      lst = ((lst % 24) + 24) % 24;
      return lst;
    }

    function hoursToHMSString(h) {
      const totalSeconds = Math.floor(h * 3600 + 0.5);
      const hh = Math.floor(totalSeconds / 3600);
      const mm = Math.floor((totalSeconds % 3600) / 60);
      const ss = totalSeconds % 60;
      return fmtHMS(hh, mm, ss);
    }

    function updateClock() {
      const now = new Date();
      if (timeLocalSpan) timeLocalSpan.textContent = fmtHMS(now.getHours(), now.getMinutes(), now.getSeconds());
      if (timeUtcSpan) timeUtcSpan.textContent = fmtHMS(now.getUTCHours(), now.getUTCMinutes(), now.getUTCSeconds());
      if (timeLstSpan) timeLstSpan.textContent = hoursToHMSString(lstInHours(now, OBS_LONGITUDE_DEG));
    }

    // ===== Connection UI =====
    function setConnection(ok) {
      if (ok) {
        connectionDot.classList.remove("badge-dot--error");
        connectionDot.classList.add("badge-dot--ok");
        connectionText.textContent = "已连接";
      } else {
        connectionDot.classList.remove("badge-dot--ok");
        connectionDot.classList.add("badge-dot--error");
        connectionText.textContent = "异常/离线";
      }
    }

    function updateConnMetrics() {
      const rtt = lastRttMs == null ? "—" : `${Math.round(lastRttMs)}ms`;
      const ok = lastOkAt == null ? "—" : fmtTime(lastOkAt).slice(0, 12);
      const poll = `${(pollDelayMs / 1000).toFixed(1)}s`;
      connMetrics.textContent = `RTT ${rtt} · OK ${ok} · FAIL ${failCount} · ${poll}`;
    }

    // ===== Fetch helper (timeout + ok check) =====
    async function apiRequest(path, { method = "GET", json = null } = {}) {
      const url = `${apiBase}${path}`;
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), FETCH_TIMEOUT_MS);

      const t0 = performance.now();
      try {
        const resp = await fetch(url, {
          method,
          headers: json ? { "Content-Type": "application/json" } : undefined,
          body: json ? JSON.stringify(json) : undefined,
          signal: controller.signal,
        });
        const t1 = performance.now();
        lastRttMs = t1 - t0;

        const text = await resp.text();
        let data = null;
        try { data = text ? JSON.parse(text) : null; } catch { data = text; }

        if (!resp.ok) {
          const detail = (data && typeof data === "object" && data.detail) ? data.detail : data;
          throw new Error(typeof detail === "string" ? detail : JSON.stringify(detail));
        }

        return data;
      } finally {
        clearTimeout(timeout);
      }
    }

    // ===== Capabilities rendering =====
    function capRow(name, ok, desc) {
      const tr = document.createElement("tr");
      const td1 = document.createElement("td");
      const td2 = document.createElement("td");
      const td3 = document.createElement("td");
      td1.textContent = name;
      td2.innerHTML = ok
        ? `<span class="pill-soft pill-ok">AVAILABLE</span>`
        : `<span class="pill-soft pill-na">N/A</span>`;
      td3.textContent = desc;
      tr.appendChild(td1);
      tr.appendChild(td2);
      tr.appendChild(td3);
      return tr;
    }

    function applyCapabilities(cap) {
      lastCapabilities = cap || null;

      const flags = cap || {};
      const map = {
        "狭缝 (slit)": { key: "slit", affects: ["slit"], desc: "狭缝宽度设置与回读" },
        "光栅 (grating)": { key: "grating", affects: ["overview"], desc: "光栅选择/回读" },
        "定标灯 (calib_lamps)": { key: "calib_lamps", affects: ["cal"], desc: "主定标灯开关（多光源后续扩展）" },
        "环境传感 (env_sensors)": { key: "env_sensors", affects: ["env"], desc: "温湿度/风/Seeing 等（本 Sprint 占位）" },
        "狭缝监测相机": { key: "slit_monitor_camera", affects: ["slit"], desc: "狭缝监测相机（本 Sprint 占位）" },
        "偏置导星": { key: "guider", affects: ["guiding"], desc: "导星相机/闭环（本 Sprint 占位）" },
        "三通道相机 B/G/R": { key: "science_channels_bgr", affects: ["cameras"], desc: "曝光/快门控制（本 Sprint 占位）" },
      };

      if (capTableBody) {
        capTableBody.innerHTML = "";
        for (const [title, item] of Object.entries(map)) {
          const ok = !!flags[item.key];
          capTableBody.appendChild(capRow(title, ok, item.desc));
        }
      }

      // Disable tabs if cap is false AND the whole tab is "future"
      const disableByTab = {
        env: !flags.env_sensors,
        guiding: !flags.guider,
        cameras: !flags.science_channels_bgr,
      };

      tabs.forEach((t) => {
        const tab = t.getAttribute("data-tab");
        if (tab in disableByTab) {
          t.disabled = disableByTab[tab];
          t.title = t.disabled ? "当前 HAL/实现未启用该模块（capabilities=false）" : "";
        }
      });

      if (envPill) envPill.textContent = flags.env_sensors ? "env_sensors: enabled" : "env_sensors: disabled";
      if (slitCapPill) slitCapPill.textContent = `cap: slit=${!!flags.slit}`;
      if (calCapPill) calCapPill.textContent = `cap: calib_lamps=${!!flags.calib_lamps}`;
      if (guidingCapPill) guidingCapPill.textContent = `cap: guider=${!!flags.guider}`;
      if (camerasCapPill) camerasCapPill.textContent = `cap: science_channels_bgr=${!!flags.science_channels_bgr}`;
    }

    // ===== State rendering =====
    function umToArcsec(um) {
      if (!Number.isFinite(um)) return null;
      return um / SLIT_SCALE_UM_PER_ARCSEC;
    }

    function fmtBool(b) { return b ? "true" : "false"; }

    function renderState(state, meta) {
      lastState = state || null;
      lastMeta = meta || null;

      if (!state) return;

      const slitUm = state.slit_width_um;
      const slitArc = umToArcsec(slitUm);

      if (chipSlit) {
        const a = slitArc == null ? "—" : `${slitArc.toFixed(2)}"`;
        chipSlit.textContent = `${slitUm.toFixed(1)} μm  (${a})`;
      }
      if (chipGrating) chipGrating.textContent = state.grating ?? "—";
      if (chipLamp) chipLamp.textContent = state.lamp_on ? "ON" : "OFF";
      if (chipTemp) chipTemp.textContent = `${(state.temperature_c ?? 0).toFixed(1)} ℃`;

      const src = meta && (meta.run_mode || meta.hal) ? `${meta.run_mode || "—"} / ${meta.hal || "—"}` : "—";
      if (chipSource) chipSource.textContent = src;

      if (chipServerUtc) chipServerUtc.textContent = (meta && meta.timestamp_utc) ? meta.timestamp_utc : "—";

      if (pillRunmode) pillRunmode.textContent = `RUN_MODE ${meta && meta.run_mode ? meta.run_mode : "—"}`;
      if (pillHal) pillHal.textContent = `HAL ${meta && meta.hal ? meta.hal : "—"}`;

      if (kvSlitUm) kvSlitUm.textContent = `${slitUm.toFixed(3)} μm`;
      if (kvSlitArcsec) kvSlitArcsec.textContent = slitArc == null ? "—" : `${slitArc.toFixed(4)} arcsec`;
      if (kvGrating) kvGrating.textContent = String(state.grating ?? "—");
      if (kvLamp) kvLamp.textContent = fmtBool(!!state.lamp_on);
      if (kvTemp) kvTemp.textContent = `${(state.temperature_c ?? 0).toFixed(3)} ℃`;

      if (envTemp) envTemp.textContent = `${(state.temperature_c ?? 0).toFixed(1)} ℃（暂用 instrument temperature）`;

      if (slitReadback) slitReadback.textContent = `${slitUm.toFixed(1)} μm`;
      if (slitReadbackHint) slitReadbackHint.textContent = slitArc == null ? "—" : `≈ ${slitArc.toFixed(2)} arcsec`;

      if (statusRawPre) {
        const dump = { state, meta, capabilities: lastCapabilities };
        statusRawPre.textContent = JSON.stringify(dump, null, 2);
      }
    }

    // ===== Polling =====
    function stopPolling() {
      if (pollTimer) clearTimeout(pollTimer);
      pollTimer = null;
    }

    function schedulePoll(nextDelayMs) {
      stopPolling();
      pollDelayMs = Math.max(POLL_MIN_MS, Math.min(POLL_MAX_MS, nextDelayMs));
      updateConnMetrics();
      pollTimer = setTimeout(pollOnce, pollDelayMs);
    }

    async function pollOnce() {
      if (document.visibilityState !== "visible") {
        schedulePoll(POLL_MAX_MS);
        return;
      }

      try {
        const data = await apiRequest("/api/v1/status/full", { method: "GET" });
        const state = data && data.state ? data.state : data;
        const cap = data && data.capabilities ? data.capabilities : null;

        lastOkAt = new Date();
        failCount = 0;
        setConnection(true);
        updateConnMetrics();

        if (cap) applyCapabilities(cap);

        renderState(state, {
          hal: data.hal,
          run_mode: data.run_mode,
          timestamp_utc: data.timestamp_utc,
        });

        if (statusFreshness) statusFreshness.textContent = `Last OK: ${fmtTime(lastOkAt)}`;

        pushLog("ok", `GET /api/v1/status/full (${Math.round(lastRttMs)}ms)`);
        schedulePoll(POLL_MIN_MS);
      } catch (e1) {
        // fallback: /api/v1/status
        try {
          const st = await apiRequest("/api/v1/status", { method: "GET" });

          lastOkAt = new Date();
          failCount = 0;
          setConnection(true);
          updateConnMetrics();

          renderState(st, { hal: "—", run_mode: "—", timestamp_utc: "—" });

          if (statusFreshness) statusFreshness.textContent = `Last OK: ${fmtTime(lastOkAt)} (fallback)`;

          pushLog("ok", `GET /api/v1/status fallback (${Math.round(lastRttMs)}ms)`);
          schedulePoll(POLL_MIN_MS);
        } catch (e2) {
          failCount += 1;
          setConnection(false);
          updateConnMetrics();
          pushLog("error", `poll failed: ${String(e2 && e2.message ? e2.message : e2)}`);
          schedulePoll(Math.min(POLL_MAX_MS, pollDelayMs * 2));
        }
      }
    }

    async function manualRefresh() {
      pushLog("info", "manual refresh");
      schedulePoll(POLL_MIN_MS);
    }

    // ===== Commands =====
    function parseNumber(id) {
      const el = document.getElementById(id);
      const v = Number(el.value);
      if (!Number.isFinite(v)) throw new Error("不是有效数字");
      return v;
    }

    function setBusy(btn, busy, label, busyLabel) {
      btn.disabled = busy;
      btn.textContent = busy ? busyLabel : label;
    }

    async function cmdSetSlit(widthValue, unit) {
      let widthUm = widthValue;
      if (unit === "arcsec") widthUm = widthValue * SLIT_SCALE_UM_PER_ARCSEC;

      if (!(widthUm > 0 && widthUm <= 5000)) {
        throw new Error(`width_um 超出范围：${widthUm.toFixed(1)}（要求 0 < x ≤ 5000）`);
      }

      pushLog("info", `UI→API POST /api/v1/slit width_um=${widthUm.toFixed(1)}`);
      const data = await apiRequest("/api/v1/slit", { method: "POST", json: { width_um: widthUm } });
      pushLog("ok", `API→UI slit applied (${Math.round(lastRttMs)}ms)`);
      renderState(data, lastMeta || {});
      schedulePoll(POLL_MIN_MS);
    }

    async function cmdSetGrating(name) {
      pushLog("info", `UI→API POST /api/v1/grating name=${name}`);
      const data = await apiRequest("/api/v1/grating", { method: "POST", json: { name } });
      pushLog("ok", `API→UI grating applied (${Math.round(lastRttMs)}ms)`);
      renderState(data, lastMeta || {});
      schedulePoll(POLL_MIN_MS);
    }

    async function cmdSetLamp(on) {
      pushLog("info", `UI→API POST /api/v1/lamp on=${on}`);
      const data = await apiRequest("/api/v1/lamp", { method: "POST", json: { on } });
      pushLog("ok", `API→UI lamp applied (${Math.round(lastRttMs)}ms)`);
      renderState(data, lastMeta || {});
      schedulePoll(POLL_MIN_MS);
    }

    // ===== API base handling =====
    function normalizeBase(s) {
      const t = (s || "").trim().replace(/\/+$/, "");
      return t;
    }

    function setApiBase(nextBase) {
      apiBase = normalizeBase(nextBase);
      apiBaseInput.value = apiBase;
      pushLog("info", `API base set to ${apiBase}`);
      // force reconnection
      lastOkAt = null;
      lastRttMs = null;
      failCount = 0;
      setConnection(false);
      updateConnMetrics();
      schedulePoll(POLL_MIN_MS);
    }

    function loadApiBase() {
      const stored = localStorage.getItem(LS_API_BASE);
      const def = window.location.origin;
      setApiBase(stored ? stored : def);
    }

    // ===== Wire events =====
    refreshStatusBtn.addEventListener("click", manualRefresh);
    if (quickRefreshBtn) quickRefreshBtn.addEventListener("click", manualRefresh);

    if (copyLogBtn) copyLogBtn.addEventListener("click", copyLogs);
    if (logsCopyBtn) logsCopyBtn.addEventListener("click", copyLogs);

    if (clearLogBtn) clearLogBtn.addEventListener("click", clearLogs);
    if (logsClearBtn) logsClearBtn.addEventListener("click", clearLogs);

    apiBaseSaveBtn.addEventListener("click", () => {
      const v = normalizeBase(apiBaseInput.value);
      localStorage.setItem(LS_API_BASE, v);
      setApiBase(v);
    });

    apiBaseResetBtn.addEventListener("click", () => {
      localStorage.removeItem(LS_API_BASE);
      setApiBase(window.location.origin);
    });

    if (slitForm) {
      slitForm.addEventListener("submit", async (evt) => {
        evt.preventDefault();
        setBusy(slitSubmitBtn, true, "应用", "发送中...");
        try {
          const width = parseNumber("slit-width");
          const unit = slitUnit.value;
          await cmdSetSlit(width, unit);
        } catch (e) {
          pushLog("error", `slit failed: ${String(e && e.message ? e.message : e)}`);
        } finally {
          setBusy(slitSubmitBtn, false, "应用", "发送中...");
        }
      });
    }

    if (slitForm2) {
      slitForm2.addEventListener("submit", async (evt) => {
        evt.preventDefault();
        setBusy(slit2SubmitBtn, true, "应用", "发送中...");
        try {
          const width = parseNumber("slit2-width");
          const unit = document.getElementById("slit2-unit").value;
          await cmdSetSlit(width, unit);
        } catch (e) {
          pushLog("error", `slit failed: ${String(e && e.message ? e.message : e)}`);
        } finally {
          setBusy(slit2SubmitBtn, false, "应用", "发送中...");
        }
      });
    }

    if (gratingForm) {
      gratingForm.addEventListener("submit", async (evt) => {
        evt.preventDefault();
        setBusy(gratingSubmitBtn, true, "应用", "发送中...");
        try {
          const name = document.getElementById("grating-name").value;
          await cmdSetGrating(name);
        } catch (e) {
          pushLog("error", `grating failed: ${String(e && e.message ? e.message : e)}`);
        } finally {
          setBusy(gratingSubmitBtn, false, "应用", "发送中...");
        }
      });
    }

    if (lampForm) {
      lampForm.addEventListener("submit", async (evt) => {
        evt.preventDefault();
        setBusy(lampSubmitBtn, true, "应用", "发送中...");
        try {
          const on = document.getElementById("lamp-on").value === "true";
          await cmdSetLamp(on);
        } catch (e) {
          pushLog("error", `lamp failed: ${String(e && e.message ? e.message : e)}`);
        } finally {
          setBusy(lampSubmitBtn, false, "应用", "发送中...");
        }
      });
    }

    if (lampForm2) {
      lampForm2.addEventListener("submit", async (evt) => {
        evt.preventDefault();
        setBusy(lamp2SubmitBtn, true, "应用", "发送中...");
        try {
          const on = document.getElementById("lamp2-on").value === "true";
          await cmdSetLamp(on);
        } catch (e) {
          pushLog("error", `lamp failed: ${String(e && e.message ? e.message : e)}`);
        } finally {
          setBusy(lamp2SubmitBtn, false, "应用", "发送中...");
        }
      });
    }

    // Pause polling when hidden, resume when visible
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") {
        pushLog("info", "page visible: resume polling");
        schedulePoll(POLL_MIN_MS);
      } else {
        pushLog("info", "page hidden: slow down polling");
        schedulePoll(POLL_MAX_MS);
      }
    });

    // ===== Init =====
    window.addEventListener("load", () => {
      pushLog("info", "UI loaded");
      loadApiBase();

      updateClock();
      setInterval(updateClock, 1000);
    });
  </script>
</body>
</html>
